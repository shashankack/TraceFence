# TraceFence  server-side only. Never commit real secrets.
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:8b
DATABASE_PATH=./data/tracefence.sqlite
APP_BASE_URL=http://localhost:3000
DEMO_MODE=true
# Prior chat turns sent to the local LLM (keep small for qwen3:8b)
CHAT_HISTORY_MESSAGES=8
CHAT_HISTORY_MSG_CHARS=900

# Comma-separated allowlist for Playwright inspect (synthetic pages only)
SOURCE_ALLOWLIST_PREFIXES=http://127.0.0.1:3000/fixtures/pages/,http://localhost:3000/fixtures/pages/
# notify_external recipient domain suffixes (demo only  no real SMTP)
NOTIFY_ALLOWLIST_SUFFIXES=nulltrace.example,nulltrace.demo,students.nulltrace.example
# Optional real SMTP for approval alerts (mock outbox always written)
# SMTP_HOST=
# SMTP_URL=
