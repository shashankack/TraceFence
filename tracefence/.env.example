# TraceFence  server-side only. Never commit real secrets.
LLM_BASE_URL=http://127.0.0.1:11434
# On Vercel: set LLM_BASE_URL to your cloudflared quick tunnel URL (https://….trycloudflare.com)
LLM_MODEL=qwen3:8b
DATABASE_PATH=./data/tracefence.sqlite
# On Vercel, SQLite uses /tmp automatically (ephemeral). Override with absolute path if needed.
# TRACEFENCE_DB_TMP=1
# HMAC secret for Bearer tokens (required for multi-instance Vercel). Demo has a stable fallback.
# AUTH_SECRET=replace-me-with-a-long-random-string
APP_BASE_URL=http://localhost:3000
DEMO_MODE=true
# Prior chat turns sent to the local LLM (keep small for qwen3:8b)
CHAT_HISTORY_MESSAGES=4
CHAT_HISTORY_MSG_CHARS=600
# Ollama speed caps
LLM_NUM_PREDICT=180
LLM_NUM_CTX=2048
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=25000
# Chunk RAG
RAG_TOP_K=3
RAG_MAX_CONTEXT_CHARS=2200

# Comma-separated allowlist for Playwright inspect (synthetic pages only)
SOURCE_ALLOWLIST_PREFIXES=http://127.0.0.1:3000/fixtures/pages/,http://localhost:3000/fixtures/pages/
# notify_external recipient domain suffixes (demo only  no real SMTP)
NOTIFY_ALLOWLIST_SUFFIXES=nulltrace.example,nulltrace.demo,students.nulltrace.example
# Optional real SMTP for approval alerts (mock outbox always written)
# SMTP_HOST=
# SMTP_URL=
